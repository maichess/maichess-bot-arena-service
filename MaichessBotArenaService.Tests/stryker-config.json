{
  "stryker-config": {
    "project": "MaichessBotArenaService.csproj",
    "solution": "../maichess-bot-arena-service.sln",
    "test-projects": [
      "MaichessBotArenaService.Tests.csproj"
    ],
    "reporters": [
      "progress",
      "html"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "!**/Program.cs",
      "!**/*.g.cs",
      "!**/*.generated.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "Console.Write*"
    ]
  }
}
